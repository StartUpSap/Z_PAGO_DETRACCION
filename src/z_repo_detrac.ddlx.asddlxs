@Metadata.layer: #CORE
annotate view Z_REPO_DETRAC with
{
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{ position: 10, label: 'Nro documento' }]
  AccountingDocument;

  @UI.lineItem: [{ position: 20, label: 'Referencia' }]
  DocumentReferenceID;

  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem: [{ position: 30, label: 'Ejercicio' }]
  FiscalYear;

  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem: [{ position: 40, label: 'Sociedad' }]
  CompanyCode;

  @UI.selectionField: [{ position: 40 }]
  @UI.lineItem: [{ position: 50, label: 'Periodo' }]
  FiscalPeriod;

  @UI.lineItem: [{ position: 60, label: 'Fecha Documento' }]
  DocumentDate;

  @UI.lineItem: [{ position: 70, label: 'Fecha Contabilización' }]
  PostingDate;

  @UI.selectionField: [{ position: 50 }]
  @UI.lineItem: [{ position: 80, label: 'Proveedor' }]
  Supplier;

  @UI.lineItem: [{ position: 90, label: 'Razón Social Proveedor' }]
  BusinessPartnerFullName;

  @UI.selectionField: [{ position: 60 }]
  @UI.lineItem: [{ position: 100, label: 'Cuenta Detracción' }]
  GLAccount;

  @UI.lineItem: [{ position: 110, label: 'Indicador Detracción' }]
  WithholdingTaxCode;

  @UI.lineItem: [{ position: 120, label: 'Moneda Documento' }]
  TransactionCurrency;

  @UI.lineItem: [{ position: 130, label: 'Base Imponible (Moneda Doc)' }]
  BaseImponibleMonDoc;

  @UI.lineItem: [{ position: 140, label: 'Importe Detracción (Moneda Doc)' }]
  ImporteDetraccionMonDoc;

  @UI.lineItem: [{ position: 150, label: 'Base Imponible (Moneda Soc)' }]
  BaseImponibleMonSoc;

  @UI.lineItem: [{ position: 160, label: 'Importe Detracción (Moneda Soc)' }]
  ImporteDetraccionMonSoc;

  @UI.lineItem: [{ position: 170, label: 'Base Imponible (Moneda Fuerte)' }]
  BaseImponibleMonFuerte;

  @UI.lineItem: [{ position: 180, label: 'Importe Detracción (Moneda Fuerte)' }]
  ImporteDetraccionMonFuerte;

  @UI.lineItem: [{ position: 190, label: 'Estado' }]
  Estado;

  @UI.lineItem: [{ position: 200, label: 'Documento Compensación' }]
  ClearingAccountingDocument;
}